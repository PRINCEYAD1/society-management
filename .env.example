# Copy this file to .env for local overrides, or set these as environment
# variables in your hosting provider's dashboard (e.g. Render).
# Never commit a real .env file with real secrets to Git.

# Generate one at https://djecrety.ir/ or run:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-long-random-string

# Set to False in production
DEBUG=False

# Comma-separated list of domains allowed to serve this app
ALLOWED_HOSTS=your-app-name.onrender.com

# From Neon dashboard -> Connection string (use the "pooled" one)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# From Cloudinary dashboard -> Account Details -> API Environment variable
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
